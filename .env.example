# کپی کنید به .env و مقادیر را عوض کنید. هرگز .env را commit نکنید.
DJANGO_DEBUG=false
# تولید کلید:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# در پروداکشن: https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# برای تست لوکال false؛ در پروداکشن (پشت HTTPS) حتماً true
DJANGO_HTTPS=false
# بعد از اطمینان از کارکرد HTTPS مثلاً 31536000 بگذارید
DJANGO_HSTS_SECONDS=0
# 0 = مستقیم بدون پروکسی (لوکال)، 1 = پشت Caddy/nginx
DRF_NUM_PROXIES=0

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db

# ---- مشخصات سالن (در سایت نمایش داده می‌شود) ----
SALON_NAME=آوین
SALON_PHONE=۰۲۱-۱۲۳۴۵۶۷۸
SALON_ADDRESS=تهران، خیابان ولیعصر، پلاک ۱۲۰
SALON_HOURS=شنبه تا پنج‌شنبه، ۹ تا ۱۷
SALON_INSTAGRAM=
